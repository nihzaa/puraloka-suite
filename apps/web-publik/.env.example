# API yang melayani /api/v1/public/situs
NEXT_PUBLIC_API_URL=http://localhost:3001

# Host Supabase — dipakai untuk URL foto di bucket publik `situs`
NEXT_PUBLIC_SUPABASE_URL=

# Company pemilik situs ini. Tanpa ini halaman gagal dengan galat yang jelas.
SITUS_COMPANY_ID=

# Rahasia bersama dengan API untuk memicu revalidate saat admin menyimpan.
SITUS_REVALIDATE_SECRET=
