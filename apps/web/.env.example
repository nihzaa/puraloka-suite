# =============================================================================
# WEB — contoh konfigurasi.  Salin ke `.env.local` (bukan `.env`).
#
#   pnpm bootstrap
#
# ⚠️ Semua yang berawalan NEXT_PUBLIC_ IKUT TERKIRIM KE BROWSER. Jangan pernah
#    menaruh service-role key, JWT_SECRET, atau string koneksi DB di sini —
#    nilainya akan terbaca siapa pun yang membuka DevTools.
# =============================================================================

# ── WAJIB ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001

# Kunci ANON — dirancang untuk publik, dibatasi RLS. Bukan service-role key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_KEY=your-anon-key-here

# ── OPSIONAL ─────────────────────────────────────────────────────────────────
# Kosong = notifikasi push mati dengan peringatan di console, bukan galat
# (lib/webpush.ts:36). Harus SAMA PERSIS dengan VAPID_PUBLIC_KEY di apps/api.
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
