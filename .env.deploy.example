# ============================================================================
# .env.deploy — satu-satunya berkas yang diisi di VPS
# ============================================================================
#   cp .env.deploy.example .env    lalu isi
#
# ⚠ Namanya `.env`, BUKAN `.env.deploy`. Compose meng-interpolasi `${...}` di
#   docker-compose.yml hanya dari `.env`; `env_file:` yang menunjuk nama lain
#   TIDAK menutupi kebutuhan itu. Salah nama = compose berhenti dengan
#   "required variable ... is missing a value" padahal berkasnya ada.
#
# ⚠ JANGAN commit `.env`. Ia sudah masuk .gitignore & .dockerignore.
#
# Daftar variabel di bawah BUKAN hasil ingatan — ia berasal dari
# `apps/api/.env.example`, yang dijaga `audit-env-siap-deploy.mjs` (ambang
# NOL: tiap env yang dibaca kode wajib punya namanya di sana). Kalau kode
# menambah variabel baru, penjaganya merah dan daftar ini ikut diperbarui.
# ============================================================================

# ── Alamat publik ───────────────────────────────────────────────────────────
DOMAIN_WEB=puraloka-suite.duckdns.org
DOMAIN_API=api.puraloka-suite.duckdns.org

# Dipakai DUA kali: dipanggang ke bundel web saat build (NEXT_PUBLIC_API_URL),
# dan dibaca API untuk menyusun tautan di surel. WAJIB https, WAJIB sama
# dengan DOMAIN_API di atas.
API_URL_PUBLIK=https://api.puraloka-suite.duckdns.org

# Alamat web, dipakai API untuk tombol di surel ke klien. Kalau kosong ia
# jatuh ke http://localhost:3000 — dan tombol di surel klien lalu menunjuk ke
# komputer si klien sendiri. Tak ada galat; kliennya cuma menyimpulkan
# aplikasinya rusak. (docs/SIAP-DEPLOY.md §1)
APP_URL=https://puraloka-suite.duckdns.org

# ── Supabase ────────────────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Dipakai dengan `!` di routes/v1/keamanan.ts — kosong = CRASH saat start,
# bukan degradasi diam-diam. Kegagalan berisik jauh lebih murah.
SUPABASE_PUBLISHABLE_KEY=
DATABASE_URL=
DIRECT_URL=

# ── Rahasia ─────────────────────────────────────────────────────────────────
# Bangkitkan masing-masing dengan:  openssl rand -base64 32
JWT_SECRET=
CREDENTIAL_ENCRYPTION_KEY=
SCHEDULER_SECRET=
WA_WEBHOOK_SECRET=

# ── Penjadwal ───────────────────────────────────────────────────────────────
SCHEDULER_EMAIL=
SCHEDULER_PASSWORD=

# ── Situs / company ─────────────────────────────────────────────────────────
SITUS_COMPANY_ID=
SITUS_REVALIDATE_SECRET=
SITUS_REVALIDATE_URL=

# ── Lain-lain ───────────────────────────────────────────────────────────────
KREDENSIAL_TANPA_JATUHAN_ENV=
PORT=3001
